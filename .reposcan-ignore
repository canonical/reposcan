# .reposcan-ignore
#   <tool>  <ruleId>  <path-glob>

# trufflehog flags sha256 hashes in lockfile due to nearby mention of 'sentry'
trufflehog  SentryToken  src/*/tools/locks/*.txt

# test fixtures
trufflehog AWS tests/scans/fixtures/*
trufflehog URI tests/unit/scans/test_repo.py

# treat the following as verified action creators
poutine  github_action_from_unverified_creator_used  **  "uses: canonical/"
poutine  github_action_from_unverified_creator_used  **  "uses: astral-sh/"

# silence zizmor and semgrep warnings about unpinned tag on first-party action
zizmor   zizmor/unpinned-uses  .github/workflows/*.yml  "uses: canonical/reposcan@main"
semgrep  *mutable-action-tag   .github/workflows/*.yml  "uses: canonical/reposcan@main"

# binding not supported for a PRAGMA; input is library-controlled and cast to int.
semgrep  *formatted-sql-query*  src/reposcan/db/sqlite.py  "PRAGMA user_version"
semgrep  *execute-raw-query*  src/reposcan/db/sqlite.py  "PRAGMA user_version"
